<?xml version="1.0" encoding="utf-8"?>
<!--
  Plain http is allowed ONLY to the phone itself (127.0.0.1 / localhost):
  the private vault plays hidden videos through a server inside the app,
  decrypting them while they play. Everything else keeps the default
  (https only).
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
